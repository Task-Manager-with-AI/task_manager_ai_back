# Choose the AI provider: "openai" (paid, easy) or "local" (free, requires faster-whisper + Ollama)
AI_PROVIDER=openai

# === OpenAI provider ===
OPENAI_API_KEY=sk-...
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_LLM_MODEL=gpt-4o-mini

# === Local provider (faster-whisper + Ollama) ===
# Install extras first:
#   pip install faster-whisper ollama
# Then pull a model on Ollama, e.g.:
#   ollama pull llama3.1:8b
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8
OLLAMA_HOST=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1:8b

DEFAULT_LANGUAGE=es
