# Choose the AI provider: "deepseek" (API + local Whisper) or "local" (Ollama + local Whisper)
AI_PROVIDER=deepseek

# === DeepSeek provider (LLM via API; transcription uses faster-whisper locally) ===
# Get your key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_LLM_MODEL=deepseek-chat

# Whisper local (used with AI_PROVIDER=deepseek and AI_PROVIDER=local)
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8

# === Local provider (Ollama LLM + faster-whisper) ===
# Install extras: pip install ollama
# Then pull a model: ollama pull llama3.1:8b
OLLAMA_HOST=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1:8b

DEFAULT_LANGUAGE=es
