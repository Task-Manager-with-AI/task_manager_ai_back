# LLM provider: "deepseek" (API) or "local" (Ollama)
AI_PROVIDER=deepseek

# Transcription: "groq" | "openai" | "local" (faster-whisper)
TRANSCRIPTION_PROVIDER=local

# === DeepSeek (LLM) ===
# Get your key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_LLM_MODEL=deepseek-chat

# === Groq Whisper API (transcription when TRANSCRIPTION_PROVIDER=groq) ===
# Get your key at https://console.groq.com/keys — free tier available
GROQ_API_KEY=gsk_...
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# === OpenAI Whisper API (transcription when TRANSCRIPTION_PROVIDER=openai) ===
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_WHISPER_MODEL=whisper-1

# === Local faster-whisper (when TRANSCRIPTION_PROVIDER=local) ===
# Use "tiny" on Render CPU; "base" for better quality on a dev machine
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8
LOCAL_WHISPER_BEAM_SIZE=1
WHISPER_PRELOAD_ON_STARTUP=true
# Optional: faster Hugging Face downloads (https://huggingface.co/settings/tokens)
# HF_TOKEN=hf_...

# === Local LLM (when AI_PROVIDER=local) ===
# Install extras: pip install ollama
# Then pull a model: ollama pull llama3.1:8b
OLLAMA_HOST=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1:8b

DEFAULT_LANGUAGE=es

# === RAG embeddings (Project Copilot) ===
# "openai" = text-embedding-3-small (1536 dims, needs OPENAI_API_KEY)
# "local"  = sentence-transformers on CPU (384 dims, no API key — good for Render demo)
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=384
EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BATCH_SIZE=32
# Warm model on startup so the first Copilot query is fast (recommended on Render)
EMBEDDING_PRELOAD_ON_STARTUP=true

# DOCX conversion service settings
DOCX_MAX_CONTENT_CHARS=200000
DOCX_CALLBACK_TIMEOUT_SECONDS=15

# Diagram generation settings (Kroki/PlantUML)
DIAGRAM_PUBLIC_DIR=diagrams
DIAGRAM_RENDER_TIMEOUT_SECONDS=10
KROKI_BASE_URL=https://kroki.io

# Diagram MVP settings (Mermaid/Kroki comparison)
DIAGRAM_MVP_PUBLIC_DIR=diagrams/mvp
DIAGRAM_MVP_TIMEOUT_SECONDS=10

# Render deploy: Docker uses requirements-render.txt when TRANSCRIPTION_PROVIDER=groq
# (no faster-whisper). Local dev with Whisper local keeps requirements.txt as-is.
